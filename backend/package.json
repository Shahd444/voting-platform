{
  "name": "mc2026-voting-api",
  "version": "1.0.0",
  "description": "MC2026 Community Awards — NestJS API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -w -p tsconfig.json & node --watch dist/main.js",
    "seed": "node dist/cli/seed.js",
    "create-admin": "node dist/cli/create-admin.js",
    "test": "jest --runInBand",
    "typeorm": "typeorm -d dist/database/data-source.js"
  },
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/serve-static": "^5.0.0",
    "typeorm": "^0.3.25",
    "pg": "^8.13.0",
    "ioredis": "^5.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "helmet": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "qrcode": "^1.5.4",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "typescript": "~5.8.0",
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/qrcode": "^1.5.5",
    "@nestjs/testing": "^11.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "@types/jest": "^29.5.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "ts-node": "^10.9.2"
  },
  "private": true,
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
